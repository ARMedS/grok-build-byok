#!/usr/bin/env python3
"""Grok Build BYOK helper: keys + live catalog + short allowlist.

Synchronizes only the managed model block in ~/.grok/config.toml from resolved.json. The original config is backed up before replacement.
Never prints a full API key except `grok-models env` (meant for eval).
"""

