PROFILE_SNIPPET = """
# grok-models BYOK keys (do not print; used by Grok Build env_key)
if [ -f "$HOME/.config/grok-models/keys.env" ]; then
  set -a
  . "$HOME/.config/grok-models/keys.env"
  set +a
fi
"""

BASHRC_MARKER = "grok-models BYOK keys"


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def mask(value: str) -> str:
    v = value.strip()
    if not v:
        return "(empty)"
    if len(v) <= 8:
        return "••••"
    return f"{v[:3]}…{v[-4:]} ({len(v)} chars)"


def atomic_write(path: Path, data: str | bytes, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    raw = data.encode("utf-8") if isinstance(data, str) else data
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(raw)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def load_keys() -> dict[str, str]:
    out: dict[str, str] = {}
    if not KEYS_FILE.is_file():
        return out
    for line in KEYS_FILE.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        k = k.strip()
        v = v.strip().strip("'").strip('"')
        if k in KEY_NAMES and v:
            out[k] = v
    return out


def write_keys(keys: dict[str, str]) -> None:
    DIR.mkdir(parents=True, exist_ok=True)
    DIR.chmod(0o700)
    lines = [
        "# Grok Build BYOK keys. Mode 600. Do not commit. Do not paste into chat.",
        "# Source of truth for grok-models. Not written into ~/.grok/config.toml.",
        "",
    ]
    for name in KEY_NAMES:
        if keys.get(name):
            val = keys[name].replace("\n", "").replace("\r", "")
            lines.append(f"{name}={val}")
    atomic_write(KEYS_FILE, "\n".join(lines) + "\n", 0o600)
    KEYS_FILE.chmod(0o600)

    # Derived copy so COSMIC-launched grok sees env_key values after login.
    env_lines = [
        "# Generated from ~/.config/grok-models/keys.env by grok-models.",
        "# Edit keys.env (or run: grok-models key). Do not put keys in config.toml.",
        "",
    ]
    for name in KEY_NAMES:
        val = keys.get(name) or ""
        if not val:
            continue
        if re.search(r"""[\s#"']""", val):
            q = val.replace("\\", "\\\\").replace('"', '\\"')
            env_lines.append(f'{name}="{q}"')
        else:
            env_lines.append(f"{name}={val}")
    ENV_D.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(ENV_D, "\n".join(env_lines) + "\n", 0o600)

    env = os.environ.copy()
    names = []
    for name, val in keys.items():
        if val:
            env[name] = val
            os.environ[name] = val
            names.append(name)
    if names:
        subprocess.run(
            ["systemctl", "--user", "import-environment", *names],
            check=False,
            env=env,
        )
        subprocess.run(
            ["dbus-update-activation-environment", "--systemd", *names],
            check=False,
            env=env,
        )


def ensure_shell_hooks() -> None:
    profile = HOME / ".profile"
    if profile.is_file():
        text = profile.read_text(encoding="utf-8")
        if BASHRC_MARKER not in text:
            with profile.open("a", encoding="utf-8") as fh:
                fh.write("\n" + PROFILE_SNIPPET)
    bashrc = HOME / ".bashrc"
    if bashrc.is_file():
        text = bashrc.read_text(encoding="utf-8")
        if BASHRC_MARKER not in text:
            needle = "case $- in"
            if needle in text:
                text = text.replace(needle, PROFILE_SNIPPET + "\n" + needle, 1)
            else:
                text = PROFILE_SNIPPET + "\n" + text
            bashrc.write_text(text, encoding="utf-8")


def load_json(path: Path) -> dict | None:
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return None


def load_allowlist() -> dict:
    data = load_json(ALLOWLIST_FILE)
    if isinstance(data, dict) and isinstance(data.get("families"), list) and data["families"]:
        # v2 -> v3 migration: add explicit auto flag (default auto-update family).
        if int(data.get("version") or 2) < 3:
            migrated = False
            for fam in data["families"]:
                if "auto" not in fam:
                    fam["auto"] = True
                    migrated = True
            if migrated:
                data["version"] = 3
                atomic_write(ALLOWLIST_FILE, json.dumps(data, indent=2) + "\n")
        return data
    atomic_write(ALLOWLIST_FILE, json.dumps(DEFAULT_ALLOWLIST, indent=2) + "\n")
    return DEFAULT_ALLOWLIST


def cmd_env() -> int:
    keys = load_keys()
    if not keys:
        print("# no keys in ~/.config/grok-models/keys.env", file=sys.stderr)
        return 1
    for name in KEY_NAMES:
        if name in keys:
            print(f"export {name}={shlex.quote(keys[name])}")
    return 0


def _int_or_none(value) -> int | None:
    try:
        return int(value) if value is not None else None
    except (TypeError, ValueError):
        return None


def is_chat_model(item: dict) -> bool:
    mid = str(item.get("id") or "")
    if ":batch" in mid:
        return False
    arch = item.get("architecture") or {}
    if isinstance(arch, dict):
        outputs = arch.get("output_modalities")
        if isinstance(outputs, list) and outputs and "text" not in outputs:
            return False
    vtype = item.get("type")
    if vtype in {"image", "video", "audio", "tts", "embedding", "embeddings"}:
        return False
    return True


def normalize_model(item: dict) -> dict | None:
    if not isinstance(item, dict) or not is_chat_model(item):
        return None
    mid = item.get("id") or item.get("name")
    if not mid:
        return None
    spec = item.get("model_spec") if isinstance(item.get("model_spec"), dict) else {}
    meta = item.get("metadata") if isinstance(item.get("metadata"), dict) else {}
    ctx = (
        item.get("context_length")
        or item.get("context_window")
        or item.get("max_model_len")
        or spec.get("availableContextTokens")
        or (item.get("top_provider") or {}).get("context_length")
    )
    display = meta.get("display_name") or spec.get("name") or item.get("name") or str(mid)
    created = _int_or_none(item.get("created")) or 0
    return {
        "id": str(mid),
        "name": str(display),
        "context_length": _int_or_none(ctx),
        "created": created,
    }


def fetch_models(provider: dict, api_key: str) -> list[dict]:
    req = urllib.request.Request(
        provider["models_url"],
        headers={
            "User-Agent": "grok-models-helper/2.0",
            "Accept": "application/json",
            "Authorization": f"Bearer {api_key}",
        },
    )
    with urllib.request.urlopen(req, timeout=25) as resp:
        payload = json.load(resp)
    data = payload.get("data", payload if isinstance(payload, list) else [])
    out = []
    for item in data:
        row = normalize_model(item)
        if row:
            out.append(row)
    out.sort(key=lambda x: (-x["created"], x["id"].lower()))
    return out


def skipped_variant(mid: str, allowed_exact: set[str]) -> bool:
    if mid in allowed_exact:
        return False
    low = mid.lower()
    return any(tag in low for tag in SKIP_TAGS)


def version_key(mid: str) -> tuple:
    parts = re.findall(r"\d+", mid)
    nums = tuple(int(p) for p in parts[:8])
    return (len(nums), nums, mid.lower())


def pick_newest(cands: list[dict]) -> dict | None:
    if not cands:
        return None
    return max(cands, key=lambda m: (m.get("created") or 0, version_key(m["id"])))


def resolve_family(family: dict, catalog: list[dict]) -> dict | None:
    by_id = {m["id"]: m for m in catalog}
    exact = list(family.get("exact") or [])
    fallback = list(family.get("fallback") or [])
    allowed = set(exact + fallback)
    for mid in exact + fallback:
        if mid in by_id and not skipped_variant(mid, allowed):
            return by_id[mid]
        if mid in by_id:
            return by_id[mid]
    prefixes = list(family.get("prefix") or [])
    for prefix in prefixes:
        cands = [
            m
            for m in catalog
            if m["id"].startswith(prefix) and not skipped_variant(m["id"], allowed)
        ]
        hit = pick_newest(cands)
        if hit:
            return hit
    return None


def _resolved_row(provider: dict, family: dict, fid: str, config_id: str, hit: dict) -> dict:
    display = hit.get("name") or hit["id"]
    return {
        "family": fid,
        "config_id": config_id,
        "provider": family.get("provider"),
        "native": False,
        "model": hit["id"],
        "name": f"{provider['label']}: {display}",
        "base_url": provider["base_url"],
        "env_key": provider["env_key"],
        "api_backend": "chat_completions",
        "stream_tool_calls": False,
        "context_length": hit.get("context_length"),
        "created": hit.get("created") or 0,
    }


def _toml_string(value: str) -> str:
    return json.dumps(str(value), ensure_ascii=False)


def render_model_block(resolved: dict) -> str:
    lines = [MODEL_BEGIN]
    seen: set[str] = set()
    for model in resolved.get("models") or []:
        if model.get("native"):
            continue
        config_id = str(model.get("config_id") or "").strip()
        if not config_id or config_id in seen:
            continue
        seen.add(config_id)
        lines.extend([
            f"[model.{config_id}]",
            f"model = {_toml_string(model.get('model') or '')}",
            f"base_url = {_toml_string(model.get('base_url') or '')}",
            f"name = {_toml_string(model.get('name') or config_id)}",
            f"env_key = {_toml_string(model.get('env_key') or '')}",
            f"api_backend = {_toml_string(model.get('api_backend') or 'chat_completions')}",
            f"context_window = {int(model.get('context_length') or 200000)}",
            f"stream_tool_calls = {'true' if model.get('stream_tool_calls') is not False else 'false'}",
            "",
        ])
    lines.append(MODEL_END)
    return "\n".join(lines) + "\n"


def _replace_managed_models(config_text: str, model_block: str) -> str:
    begin = config_text.find(MODEL_BEGIN)
    end = config_text.find(MODEL_END)
    if begin >= 0 or end >= 0:
        if begin < 0 or end < begin:
            raise ValueError("config.toml has incomplete grok-models-helper markers")
        end += len(MODEL_END)
        return config_text[:begin] + model_block.rstrip("\n") + config_text[end:]

    # One-time migration for this host's existing layout: custom model tables
    # are the final tables in config.toml. Preserve everything before them.
    match = re.search(r"(?m)^\[model\.", config_text)
    if not match:
        separator = "\n" if config_text.endswith("\n") else "\n\n"
        return config_text + separator + model_block
    prefix = config_text[:match.start()].rstrip() + "\n\n"
    return prefix + model_block


def apply_resolved(dry_run: bool = False) -> int:
    resolved = load_json(RESOLVED_FILE)
    if not isinstance(resolved, dict) or not isinstance(resolved.get("models"), list):
        print(f"No usable {RESOLVED_FILE}; run grok-models refresh first.", file=sys.stderr)
        return 1
    if not GROK_CONFIG.is_file():
        print(f"Grok config not found: {GROK_CONFIG}", file=sys.stderr)
        return 1
    try:
        current = GROK_CONFIG.read_text(encoding="utf-8")
        candidate = _replace_managed_models(current, render_model_block(resolved))
        import tomllib
        tomllib.loads(candidate)
    except Exception as exc:
        print(f"Refusing to update config.toml: {exc}", file=sys.stderr)
        return 1
    if dry_run:
        print(f"Would update managed model block in {GROK_CONFIG}")
        print(f"  models: {sum(1 for m in resolved['models'] if not m.get('native'))} BYOK")
        return 0
    try:
        mode = GROK_CONFIG.stat().st_mode & 0o777
        shutil.copy2(GROK_CONFIG, GROK_CONFIG_BACKUP)
        atomic_write(GROK_CONFIG, candidate, mode)
    except Exception as exc:
        print(f"Could not update config.toml: {exc}", file=sys.stderr)
        return 1
    print(f"Applied {sum(1 for m in resolved['models'] if not m.get('native'))} BYOK models to {GROK_CONFIG}")
    return 0


def cmd_refresh() -> int:
    keys = load_keys()
    previous = load_json(CATALOG_FILE) or {}
    prev_providers = previous.get("providers") if isinstance(previous.get("providers"), dict) else {}

    providers_out: dict[str, dict] = {}
    failed: list[str] = []
    fetched_any = False

    print("Refreshing provider catalogs and resolving selected models…")
    for pid, p in PROVIDERS.items():
        key = keys.get(p["env_key"])
        if not key:
            print(f"  {p['label']}: skipped (no API key yet)")
            old = prev_providers.get(pid)
            if isinstance(old, dict) and old.get("models"):
                providers_out[pid] = old
            continue
        try:
            catalog = fetch_models(p, key)
        except urllib.error.HTTPError as e:
            print(f"  {p['label']}: fetch failed ({e.code}); keeping last good catalog")
            failed.append(pid)
            old = prev_providers.get(pid)
            if isinstance(old, dict) and old.get("models"):
                providers_out[pid] = old
            continue
        except Exception as e:
            print(f"  {p['label']}: fetch failed ({e}); keeping last good catalog")
            failed.append(pid)
            old = prev_providers.get(pid)
            if isinstance(old, dict) and old.get("models"):
                providers_out[pid] = old
            continue
        if not catalog:
            print(f"  {p['label']}: empty list; keeping last good catalog")
            failed.append(pid)
            old = prev_providers.get(pid)
            if isinstance(old, dict) and old.get("models"):
                providers_out[pid] = old
            continue
        fetched_any = True
        providers_out[pid] = {"ok": True, "count": len(catalog), "models": catalog}
        print(f"  {p['label']}: {len(catalog)} live")

    catalog_doc = {"updated": now_iso(), "providers": providers_out}
    if fetched_any or providers_out:
        atomic_write(CATALOG_FILE, json.dumps(catalog_doc, indent=2) + "\n")
    elif previous:
        print("  No catalog written; last good file left in place.")

    allowlist = load_allowlist()
    resolved_models = []
    skipped = []
    used_ids: set[str] = set()

    for family in allowlist.get("families") or []:
        pid = family.get("provider")
        fid = family.get("family") or family.get("config_id")
        config_id = family.get("config_id") or fid
        if pid == "native":
            resolved_models.append(
                {
                    "family": fid,
                    "config_id": config_id,
                    "provider": "native",
                    "native": True,
                    "model": (family.get("exact") or [config_id])[0],
                    "name": "Grok 4.6 (native)",
                }
            )
            continue
        if pid not in PROVIDERS:
            skipped.append({"family": fid, "reason": f"unknown provider {pid}"})
            continue
        p = PROVIDERS[pid]
        if not keys.get(p["env_key"]):
            skipped.append({"family": fid, "reason": f"no {p['env_key']}"})
            continue
        models = (providers_out.get(pid) or {}).get("models") or []
        is_pinned = family.get("auto") is False
        if is_pinned:
            # Pinned (manual) entry: resolve each exact id present in the catalog.
            by_id = {m["id"]: m for m in models}
            added_any = False
            pin_ids = list(family.get("exact") or [])
            if not pin_ids:
                skipped.append({"family": fid, "reason": "pinned entry has no exact ids"})
                continue
            for idx, mid in enumerate(pin_ids):
                hit = by_id.get(mid)
                if not hit:
                    skipped.append({"family": fid, "reason": f"{mid} not in catalog"})
                    continue
                sub_id = config_id if len(pin_ids) == 1 else f"{config_id}.{idx}"
                if sub_id in used_ids:
                    skipped.append({"family": fid, "reason": f"duplicate config_id {sub_id}"})
                    continue
                used_ids.add(sub_id)
                added_any = True
                resolved_models.append(_resolved_row(p, family, fid, sub_id, hit))
            if not added_any:
                # Already reported per-id; no extra global message needed.
                pass
            continue
        # Auto-update family: resolve newest matching variant (existing semantics).
        hit = resolve_family(family, models)
        if not hit:
            skipped.append({"family": fid, "reason": "not in catalog"})
            continue
        if config_id in used_ids:
            skipped.append({"family": fid, "reason": f"duplicate config_id {config_id}"})
            continue
        used_ids.add(config_id)
        resolved_models.append(_resolved_row(p, family, fid, config_id, hit))

    resolved_doc = {
        "updated": now_iso(),
        "models": resolved_models,
        "skipped": skipped,
    }
    atomic_write(RESOLVED_FILE, json.dumps(resolved_doc, indent=2) + "\n")

    byok = [m for m in resolved_models if not m.get("native")]
    print()
    print(f"Resolved {len(byok)} BYOK + {len(resolved_models) - len(byok)} native → {RESOLVED_FILE}")
    for m in resolved_models:
        if m.get("native"):
            print(f"  {m['config_id']:28} native (no [model.*] table)")
        else:
            print(f"  {m['config_id']:28} {m['model']}")
    if skipped:
        print("Skipped:")
        for s in skipped:
            print(f"  {s['family']}: {s['reason']}")
    print()
    print("The managed model block is synchronized when the picker saves, refresh completes, or grok starts.")

    if failed:
        return 1
    if not keys:
        print("Add a key first: grok-models key", file=sys.stderr)
        return 1
    return 0


def cmd_refresh_and_apply() -> int:
    result = cmd_refresh()
    return apply_resolved() if result == 0 else result


def cmd_status() -> int:
    keys = load_keys()
    print("Keys (~/.config/grok-models/keys.env):")
    for pid, p in PROVIDERS.items():
        val = keys.get(p["env_key"])
        print(f"  {p['label']:12} {p['env_key']:22} {mask(val) if val else 'NO KEY'}")
    resolved = load_json(RESOLVED_FILE)
    print()
    if not resolved:
        print("No resolved.json yet. Run: grok-models refresh")
        return 0
    print(f"Resolved ({resolved.get('updated', '?')}):")
    for m in resolved.get("models") or []:
        if m.get("native"):
            print(f"  {m.get('config_id')}  native")
        else:
            print(f"  {m.get('config_id'):28} {m.get('model')}")
    skipped = resolved.get("skipped") or []
    if skipped:
        print("Skipped:")
        for s in skipped:
            print(f"  {s.get('family')}: {s.get('reason')}")
    return 0


def prompt(msg: str, default: str = "") -> str:
    suffix = f" [{default}]" if default else ""
    try:
        raw = input(f"{msg}{suffix}: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return ""
    return raw or default


def action_key(provider_id: str | None = None) -> int:
    keys = load_keys()
    ids = list(PROVIDERS)
    if not provider_id:
        print("\nProvider")
        for i, pid in enumerate(ids, 1):
            p = PROVIDERS[pid]
            status = "key set" if keys.get(p["env_key"]) else "no key yet"
            print(f"  {i}) {p['label']}  ({status})")
        print("  0) cancel")
        choice = prompt("Number")
        if choice in {"0", ""}:
            return 0
        try:
            provider_id = ids[int(choice) - 1]
        except (ValueError, IndexError):
            print("  Invalid choice.")
            return 1
    provider_id = provider_id.lower().strip()
    aliases = {"or": "openrouter", "nw": "neuralwatt", "va": "venice"}
    provider_id = aliases.get(provider_id, provider_id)
    if provider_id not in PROVIDERS:
        print(f"  Unknown provider {provider_id!r}. Use: openrouter, neuralwatt, venice")
        return 1
    p = PROVIDERS[provider_id]
    existing = keys.get(p["env_key"], "")
    print(f"\n{p['label']}")
    print(f"  Get a key: {p['key_help']}")
    print(f"  Stored as: {p['env_key']} in {KEYS_FILE}")
    if existing:
        print(f"  Current:   {mask(existing)}")
        if prompt("Replace this key? (y/N)", "n").lower() not in {"y", "yes"}:
            return 0
    print("  (input is hidden; paste the key and press Enter. Nothing is logged.)")
    try:
        value = getpass.getpass("  key: ").strip()
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled.")
        return 1
    if not value:
        return 1
    keys[p["env_key"]] = value
    write_keys(keys)
    ensure_shell_hooks()
    print(f"  Saved {p['env_key']} = {mask(value)}")
    print("  Refreshing catalogs and synchronizing the managed model block.")
    return cmd_refresh_and_apply()


# ---------------------------------------------------------------------------
# Interactive model picker (raw terminal TUI)
# ---------------------------------------------------------------------------

_ESC = b"\x1b"


def _term_size() -> tuple[int, int]:
    try:
        return os.get_terminal_size().columns, os.get_terminal_size().lines
    except OSError:
        return 80, 24


def _nowrap(text: str, width: int) -> str:
    if len(text) <= width:
        return text
    return text[: max(0, width - 1)] + "…"


def slugify_model(model_id: str) -> str:
    s = model_id.lower().replace("/", "-").replace(".", "-")
    s = re.sub(r"[^a-z0-9_-]+", "-", s).strip("-")
    return s or "model"


def _gen_config_id(provider_id: str, model_id: str, existing: set[str]) -> str:
    base = f"{PROVIDERS[provider_id]['prefix']}-{slugify_model(model_id)}"
    cand = base
    n = 1
    while cand in existing:
        n += 1
        cand = f"{base}-{n}"
    return cand


class ModelPicker:
    """Full-catalog checkbox picker for one BYOK provider at a time."""

    def __init__(self, allowlist: dict, catalog: dict, start_provider: str | None = None):
        self.allowlist = allowlist
        self.catalog = catalog
        fams = allowlist.get("families") or []
        idx = list(PROVIDERS).index(start_provider) if start_provider in PROVIDERS else 0
        self.provider_idx = idx
        # auto family templates: key -> family dict (defaults + any custom in allowlist)
        self.auto_tpl: dict[str, dict[str, dict]] = {}
        # auto family keys currently active (present in the allowlist)
        self.auto_active: dict[str, set[str]] = {}
        # pinned model-id -> entry (auto False) keyed by provider
        self.pinned_by_pid: dict[str, dict[str, dict]] = {}
        for fam in fams:
            pid = fam.get("provider")
            if pid == "native" or pid not in PROVIDERS:
                continue
            if fam.get("auto") is False:
                self.pinned_by_pid.setdefault(pid, {})
                for mid in fam.get("exact") or []:
                    self.pinned_by_pid[pid][mid] = fam
            else:
                key = fam.get("config_id") or fam.get("family")
                self.auto_tpl.setdefault(pid, {})[key] = dict(fam)
                self.auto_active.setdefault(pid, set()).add(key)
        # default auto templates available to (re)enable
        for fam in DEFAULT_ALLOWLIST.get("families") or []:
            pid = fam.get("provider")
            if pid == "native" or pid not in PROVIDERS or fam.get("auto") is False:
                continue
            key = fam.get("config_id") or fam.get("family")
            self.auto_tpl.setdefault(pid, {})
            if key not in self.auto_tpl[pid]:
                self.auto_tpl[pid][key] = dict(fam)
        self.search = ""
        self._filtering = False
        self._last_action = "quit"
        self.cursor = 0
        self.scroll = 0
        self.rows: list[tuple] = []  # (section, key)
        self.row_y: list[tuple] = []  # (display_y, section, key)

    # -- state queries -----------------------------------------------------
    def pid(self) -> str:
        return list(PROVIDERS)[self.provider_idx]

    def provider(self) -> dict:
        return PROVIDERS[self.pid()]

    def models(self) -> list[dict]:
        return (self.catalog.get("providers") or {}).get(self.pid(), {}).get("models") or []

    def auto_rows(self) -> list[dict]:
        pid = self.pid()
        return list((self.auto_tpl.get(pid) or {}).values())

    def auto_on(self, key: str) -> bool:
        return key in (self.auto_active.get(self.pid()) or set())

    def _rebuild_rows(self) -> None:
        pid = self.pid()
        rows: list[tuple] = []
        for fam in self.auto_rows():
            rows.append(("auto", fam.get("config_id") or fam.get("family")))
        q = self.search.strip().lower()
        for m in self.models():
            if q and q not in m["id"].lower() and q not in (m.get("name") or "").lower():
                continue
            rows.append(("model", m["id"]))
        self.rows = rows
        if self.cursor >= len(rows):
            self.cursor = max(0, len(rows) - 1)
        if self.cursor < 0:
            self.cursor = 0

    def is_row_checked(self, section: str, key: str) -> bool:
        if section == "auto":
            return self.auto_on(key)
        return key in (self.pinned_by_pid.get(self.pid()) or {})

    def toggle_at(self, index: int) -> None:
        if not (0 <= index < len(self.rows)):
            return
        section, key = self.rows[index]
        pid = self.pid()
        if section == "auto":
            active = self.auto_active.setdefault(pid, set())
            if key in active:
                active.discard(key)
            else:
                # add template (default or preserved custom) to active set
                if key not in self.auto_tpl.setdefault(pid, {}):
                    self.auto_tpl[pid][key] = {
                        "family": key,
                        "config_id": key,
                        "provider": pid,
                        "prefix": [],
                        "auto": True,
                    }
                active.add(key)
        else:  # model (pinned)
            pins = self.pinned_by_pid.setdefault(pid, {})
            if key in pins:
                del pins[key]
            else:
                existing = {f.get("config_id") for f in self.allowlist.get("families") or []}
                pins[key] = {
                    "family": key,
                    "config_id": _gen_config_id(pid, key, existing),
                    "provider": pid,
                    "exact": [key],
                    "auto": False,
                }

    # -- rendering ----------------------------------------------------------
    def _auto_resolved(self, fam: dict) -> str:
        models = (self.catalog.get("providers") or {}).get(self.pid(), {}).get("models") or []
        hit = resolve_family(fam, models)
        return hit["id"] if hit else ""

    def build_screen(self) -> tuple[list[str], list[tuple]]:
        """Return (lines, clickable) where clickable = (display_y, section, key)."""
        cols, lines = _term_size()
        pid = self.pid()
        p = self.provider()
        self._rebuild_rows()

        out: list[str] = []
        clickable: list[tuple] = []

        def emit(text: str, row: tuple | None = None):
            out.append(text)
            if row is not None:
                if (len(out) - 1, row[0], row[1]) not in clickable:
                    clickable.append((len(out) - 1, row[0], row[1]))

        n_auto = len(self.auto_rows())
        n_auto_on = sum(1 for key in (self.auto_active.get(pid) or set()) if key in (self.auto_tpl.get(pid) or {}))
        n_model = len(self.models())
        n_pinned = len(self.pinned_by_pid.get(pid) or {})

        emit(f"  Grok Models — model selection          provider: {p['label']}   "
             f"({n_auto_on} auto family / {n_pinned} pinned)")
        emit("  [Tab/←/→] provider   [↑/↓] move   [Space] toggle   [Enter] save")
        emit("  [/] filter   [Esc/q] cancel")

        emit(f"  Auto-updating families  ({n_auto_on}/{n_auto} on):")
        for fam in self.auto_rows():
            key = fam.get("config_id") or fam.get("family")
            on = self.auto_on(key)
            box = "[x]" if on else "[ ]"
            resolved = self._auto_resolved(fam)
            label = f"{key}  → {resolved}" if resolved else key
            emit(f"  {box} {_nowrap(label, cols - 8)}", ("auto", key))

        shown = [s for s in self.rows if s[0] == "model"]
        if self.search:
            emit(f"  Individual models  (filter: {self.search!r})  {len(shown)}/{n_model}:")
        else:
            emit(f"  Individual models  ({n_model}):")

        model_indices = [i for i, row in enumerate(self.rows) if row[0] == "model"]
        model_budget = max(1, lines - len(out) - 2)
        if self.cursor in model_indices:
            cursor_model = model_indices.index(self.cursor)
            if cursor_model < self.scroll:
                self.scroll = cursor_model
            elif cursor_model >= self.scroll + model_budget:
                self.scroll = cursor_model - model_budget + 1
        max_scroll = max(0, len(model_indices) - model_budget)
        self.scroll = min(max(0, self.scroll), max_scroll)

        for i in model_indices[self.scroll : self.scroll + model_budget]:
            key = self.rows[i][1]
            on = key in (self.pinned_by_pid.get(pid) or {})
            box = "[x]" if on else "[ ]"
            emit(f"  {box} {_nowrap(key, cols - 8)}", ("model", key))

        emit("")
        emit("  [Tab/←/→] provider   [↑/↓] move   [Space] toggle   [Enter] save   [Esc/q] cancel")
        return out, clickable

    def draw(self) -> None:
        sys.stdout.write("\x1b[H\x1b[2J")
        lines, clickable = self.build_screen()
        self.row_y = clickable
        # highlight cursor row (reverse video)
        if self.rows and 0 <= self.cursor < len(self.rows):
            section, key = self.rows[self.cursor]
            for y, s, k in clickable:
                if s == section and k == key:
                    lines[y] = "\x1b[7m" + lines[y] + "\x1b[0m"
                    break
        sys.stdout.write("\r\n".join(lines))
        sys.stdout.write("\x1b[0m")
        sys.stdout.flush()

    def enter(self) -> None:
        """Run the picker in keyboard-only cbreak mode.

        Mouse reporting is deliberately disabled: terminal mouse escape sequences
        can interfere with keyboard input on some terminals.
        """
        self._last_action = "quit"
        old = termios.tcgetattr(sys.stdin.fileno())
        try:
            self.draw()
            tty.setcbreak(sys.stdin.fileno())
            self._loop()
        finally:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
            sys.stdout.write("\x1b[0m\x1b[2J\x1b[H")
            sys.stdout.flush()

    def _loop(self) -> None:
        buf = b""
        while True:
            ready, _, _ = select.select([sys.stdin], [], [], 0.1)
            if ready:
                try:
                    buf += os.read(sys.stdin.fileno(), 128)
                except OSError:
                    continue
            if not buf:
                continue
            decoded = self._decode(buf)
            if decoded is None:
                continue
            key, consumed = decoded
            buf = buf[consumed:]
            action = self._handle(key)
            self.draw()
            if action == "quit":
                self._last_action = "quit"
                return
            if action == "saved":
                self._last_action = "saved"
                return

    # -- keyboard decoding --------------------------------------------------
    def _decode(self, buf: bytes):
        if buf.startswith(_ESC):
            if len(buf) == 1:
                # Escape is also the first byte of arrow sequences. Give a
                # following sequence a short chance to arrive.
                ready, _, _ = select.select([sys.stdin], [], [], 0.08)
                if ready:
                    try:
                        return self._decode(buf + os.read(sys.stdin.fileno(), 8))
                    except OSError:
                        pass
                return (("quit",), 1)
            sequences = {
                b"\x1b[A": "up", b"\x1bOA": "up",
                b"\x1b[B": "down", b"\x1bOB": "down",
                b"\x1b[C": "right", b"\x1bOC": "right",
                b"\x1b[D": "left", b"\x1bOD": "left",
            }
            for sequence, key in sequences.items():
                if buf.startswith(sequence):
                    return ((key,), len(sequence))
            # Ignore unknown escape sequences one byte at a time, preserving
            # later keyboard input rather than wedging the picker.
            return (("quit",), 1)
        return ((buf[:1],), 1)

    def _handle(self, key: tuple):
        kind = key[0]
        if kind == "quit":  # Esc
            if self._filtering:
                self._filtering = False
                return
            return "quit"
        if kind == "up":
            if self.cursor > 0:
                self.cursor -= 1
            return
        if kind == "down":
            if self.cursor < len(self.rows) - 1:
                self.cursor += 1
            return
        if kind in ("right", "left") or kind == b"\t":
            if kind == "left":
                self.provider_idx = (self.provider_idx - 1) % len(PROVIDERS)
            else:
                self.provider_idx = (self.provider_idx + 1) % len(PROVIDERS)
            self._reset_view()
            return
        if kind == "mouse":
            y = key[1]
            for dy, s, k in self.row_y:
                if dy == y:
                    for idx, r in enumerate(self.rows):
                        if r[0] == s and r[1] == k:
                            self.toggle_at(idx)
                            return
            return
        if kind in (b" ",):
            self.toggle_at(self.cursor)
            return
        if kind in (b"\r", b"\n"):
            return "saved"
        if kind in (b"/",):
            self._filtering = True
            return
        if kind == b"\x7f":  # backspace
            if self._filtering:
                self.search = self.search[:-1]
            return
        if isinstance(kind, bytes) and kind and kind.isascii():
            if self._filtering:
                ch = kind.decode("ascii", "replace")
                if ch.isprintable():
                    self.search += ch
                return
            if kind in (b"q", b"Q"):
                return "quit"
        return

    def _reset_view(self):
        self.search = ""
        self.cursor = 0
        self.scroll = 0

    # -- persistence ---------------------------------------------------------
    def apply(self) -> dict:
        """Rebuild allowlist from the picker state. Returns the new allowlist doc."""
        fams = []
        for fam in self.allowlist.get("families") or []:
            pid = fam.get("provider")
            if pid == "native" or pid not in PROVIDERS:
                fams.append(fam)
                continue
            # pinned and auto BYOK entries are rebuilt from picker state below
        # active auto families (template preserves custom patterns where present)
        for pid, active in self.auto_active.items():
            tpls = self.auto_tpl.get(pid) or {}
            for key in active:
                fam = tpls.get(key) or {
                    "family": key,
                    "config_id": key,
                    "provider": pid,
                    "prefix": [],
                    "auto": True,
                }
                fams.append(dict(fam))
        # pinned entries
        existing_ids = {f.get("config_id") for f in fams}
        for pid, pins in self.pinned_by_pid.items():
            for mid, fam in pins.items():
                cfg = fam.get("config_id")
                if cfg in existing_ids:
                    base = f"{PROVIDERS[pid]['prefix']}-{slugify_model(mid)}"
                    cfg = base
                    n = 1
                    while cfg in existing_ids:
                        n += 1
                        cfg = f"{base}-{n}"
                existing_ids.add(cfg)
                fams.append({
                    "family": mid,
                    "config_id": cfg,
                    "provider": pid,
                    "exact": [mid],
                    "auto": False,
                })
        return {"version": 3, "families": fams}


def cmd_pick(provider_arg: str | None = None) -> int:
    """Interactive model picker. Returns 0 on save, 1 on quit/cancel."""
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("grok-models pick is interactive; run it in a terminal.", file=sys.stderr)
        return 2
    allowlist = load_allowlist()
    catalog = load_json(CATALOG_FILE) or {}
    start = None
    if provider_arg:
        a = provider_arg.lower().strip()
        aliases = {"or": "openrouter", "nw": "neuralwatt", "va": "venice"}
        start = aliases.get(a, a)
        if start not in PROVIDERS:
            print(f"  Unknown provider {provider_arg!r}. Use: openrouter, neuralwatt, venice")
            return 1
    if not catalog.get("providers"):
        print("  No catalog yet. Run `grok-models refresh` first to fetch provider models.")
        return 1
    picker = ModelPicker(allowlist, catalog, start)
    try:
        picker.enter()
    except KeyboardInterrupt:
        print("\nCancelled.")
        return 1
    # enter() returns us here after a quit/saved action
    result = picker._last_action
    if result != "saved":
        print("\nNo changes saved.")
        return 1
    new_allowlist = picker.apply()
    atomic_write(ALLOWLIST_FILE, json.dumps(new_allowlist, indent=2) + "\n")
    print(f"\nSaved selection → {ALLOWLIST_FILE}")
    print("Re-resolving allowlist into resolved.json…")
    print()
    try:
        result = cmd_refresh()
        return apply_resolved() if result == 0 else result
    except KeyboardInterrupt:
        print("  Catalog refresh cancelled.")
        return 1


def cmd_menu() -> int:
    ensure_shell_hooks()
    print()
    print("Grok Models — keys + model selection (syncs managed config.toml models)")
    print(f"Keys: {KEYS_FILE}")
    print(f"Allowlist: {ALLOWLIST_FILE}")
    print()
    try:
        cmd_refresh()
    except KeyboardInterrupt:
        print("  Catalog refresh cancelled.")
    print()
    while True:
        print("  1) Refresh catalogs / resolve allowlist")
        print("  2) Select models … (checkbox picker)")
        print("  3) Add or replace an API key")
        print("  4) Status")
        print("  0) Quit")
        choice = prompt("\nWhat do you want to do")
        print()
        if choice in {"0", "q", "quit", ""}:
            return 0
        try:
            {
                "1": cmd_refresh_and_apply,
                "2": lambda: cmd_pick(None),
                "3": lambda: action_key(None),
                "4": cmd_status,
            }[choice]()
        except KeyboardInterrupt:
            print("\nCancelled that step.")
        except KeyError:
            print("  Unknown choice.")
        print()


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="grok-models",
        description="Manage BYOK keys, selected models, and the managed config.toml model block.",
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="",
        help="env | refresh | apply [--dry-run] | pick [provider] | key [provider] | status  (default: interactive)",
    )
    parser.add_argument("provider", nargs="?", help="openrouter | neuralwatt | venice")
    parser.add_argument("--dry-run", action="store_true", help="show an apply operation without writing config.toml")
    args = parser.parse_args()
    cmd = (args.command or "").lower()
    if cmd == "env":
        return cmd_env()
    if cmd == "refresh":
        result = cmd_refresh()
        return apply_resolved() if result == 0 else result
    if cmd == "apply":
        return apply_resolved(args.dry_run)
    if cmd in {"status", "list"}:
        return cmd_status()
    if cmd in {"pick", "select", "select-models"}:
        return cmd_pick(args.provider)
    if cmd == "key":
        if not sys.stdin.isatty():
            print("grok-models key is interactive.", file=sys.stderr)
            return 1
        return action_key(args.provider)
    if cmd in {"", "menu"}:
        if not sys.stdin.isatty():
            print("Run grok-models refresh, grok-models pick, grok-models env, or grok-models status.", file=sys.stderr)
            return 1
        return cmd_menu()
    parser.error(f"unknown command {args.command!r}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
